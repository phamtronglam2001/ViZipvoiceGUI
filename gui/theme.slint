export global Theme {
    in-out property <bool> dark-mode: true;

    in-out property <brush> window-bg: dark-mode ? #1a1b26 : #f4f5f7;
    in-out property <brush> panel-bg: dark-mode ? #24283b : #ffffff;
    in-out property <brush> panel-border: dark-mode ? #414868 : #d8dce6;
    in-out property <brush> text-primary: dark-mode ? #c0caf5 : #1f2330;
    in-out property <brush> text-secondary: dark-mode ? #9aa5ce : #5c6378;
    in-out property <brush> accent: dark-mode ? #7aa2f7 : #3b6fd9;
    in-out property <brush> accent-hover: dark-mode ? #89b4fa : #2f5fc4;
    in-out property <brush> log-bg: dark-mode ? #16161e : #eef0f4;
    in-out property <brush> danger: #f7768e;
    in-out property <length> radius: 8px;
    in-out property <length> pad: 12px;
}
